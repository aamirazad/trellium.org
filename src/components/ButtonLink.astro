---
interface Props {
	href: string;
	className?: string;
	rel?: string;
	target?: string;
}

const { href, className, rel = "noopener", target } = Astro.props;
---

<button
	class={"px-4 py-2 bg-white/15 hover:opacity-80 inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive" +
		(className ? ` ${className}` : "")}
>
	<a class="" {href} rel={rel} target={target}> <slot /> </a>
</button>
