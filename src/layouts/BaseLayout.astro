---
interface Props {
	url?: string;
	title?: string;
	image?: string;
	description?: string;
}

const { url, title, image, description } = Astro.props;
import "@fontsource/kanit/500.css";
import "@fontsource-variable/inter";
import "@/styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<title>{title ? title : "Trellium"}</title>
		<meta
			name="description"
			content={description
				? description
				: "The foundation of symbiotic software"}
		/>
		<!-- Open Graph tags -->
		<meta property="og:title" content={title ? title : "Trellium"} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={url ? url : Astro.url} />
		<meta
			property="og:description"
			content={description
				? description
				: "The foundation of symbiotic software"}
		/>
		{image && <meta property="og:image" content={image} />}

		<!-- Analytics -->
		<script>
			import rybbit from "@rybbit/js";

			rybbit.init({
				analyticsHost: "https://analytics.aamira.me/api",
				siteId: "8",
			});
		</script>

		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Other -->
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
	</head>
	<slot />


</html>
